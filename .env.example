# Copy this file to .env and fill in your own values.
# Get a free Gemini API key (no billing required) from Google AI Studio:
# https://aistudio.google.com/app/apikey
#
# InsightAI works fully without this key — core analytics (KPIs, charts,
# trends, data health) never depend on Gemini. Only AI Insights, Ask Your
# Data, Recommendations, and the report narrative require it.
GEMINI_API_KEY=your_api_key_here
